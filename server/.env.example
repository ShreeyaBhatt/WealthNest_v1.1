# ============================================================
# server/.env.example — Node.js Backend Environment Variables
#
# HOW TO USE:
# 1. Copy this file: copy .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to Git (it's in .gitignore)
# ============================================================

# ─── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ────────────────────────────────────────────────
# Since you're using local MongoDB with Compass:
MONGO_URI=mongodb://localhost:27017/wealthnest

# ─── JWT (JSON Web Token) ───────────────────────────────────
# Use a long, random string — this is used to sign/verify tokens
# Generate one at: https://randomkeygen.com/
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Refresh token has longer expiry than access token
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRE=30d

# ─── Django AI Backend URL ───────────────────────────────────
# Node.js calls Django's APIs for ML and AI features
DJANGO_URL=http://localhost:8000

# ─── Email (for Forgot Password) ────────────────────────────
# For development: leave these blank — token will be logged to console
# For production: use your Gmail with App Password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── CORS (Frontend URL) ────────────────────────────────────
CLIENT_URL=http://localhost:3000
